// Osysharp.Memory.Testing — what a suite can assert with the words embedder: a row is found by the words it holds, the
// closest first, never one the searcher may not read; and the same text is the same vector on every machine.

using Osysharp.Memory;
using Osysharp.Memory.Testing;

/// Two gardeners, three notes — one of them Bo's own.
[TestFixture]
void Garden() {
  TestEmbedder.Use(new WordsEmbedder());
  var ann = new Gardener { Email = "ann@garden.test" };
  var bo = new Gardener { Email = "bo@garden.test" };
  new FieldNote { Title = "Tomatoes", Body = "The tomatoes split after heavy rain; water them evenly and mulch the bed." };
  new FieldNote { Title = "Roses", Body = "Prune the climbing roses in late winter, above an outward facing bud." };
  new FieldNote { Title = "Bo's compost", Body = "My compost heap smells of ammonia — add dry leaves and turn the heap.", Keeper = bo };
}

principal Ann => Gardener.Single(g => g.Email == "ann@garden.test");
principal Bo => Gardener.Single(g => g.Email == "bo@garden.test");

[Test(Garden)]
void a_note_is_found_by_the_words_it_holds() {
  runas (Ann) {
    var hits = FindNotes("tomatoes split after rain");
    Assert.Equal("Tomatoes", hits[0].Title);
  }
}

[Test(Garden)]
void the_closest_note_comes_first() {
  runas (Ann) {
    var hits = FindNotes("prune climbing roses winter bud");
    Assert.Equal("Roses", hits[0].Title);
    Assert.True(hits.All(h => h.Title != "Tomatoes" || h.Score < hits[0].Score));
  }
}

[Test(Garden)]
void a_note_the_searcher_may_not_read_is_never_found() {
  runas (Ann) { Assert.Equal(0, FindNotes("compost heap smells ammonia dry leaves").Count(h => h.Title == "Bo's compost")); }
  // The control: its keeper finds it with the same words.
  runas (Bo) { Assert.Equal("Bo's compost", FindNotes("compost heap smells ammonia dry leaves")[0].Title); }
}

[Test(Garden)]
void a_note_written_in_the_test_is_found_on_the_next_line() {
  runas (Ann) {
    new FieldNote { Title = "Garlic", Body = "Plant garlic cloves in autumn, pointed end up, a hand apart." };
    UnitOfWork.Commit();
    Assert.Equal("Garlic", FindNotes("plant garlic cloves autumn")[0].Title);
  }
}

[Test]
void the_same_text_is_the_same_vector_of_length_one() {
  var e = new WordsEmbedder();
  var a = e.Embed("Water the tomatoes evenly", 384);
  var b = e.Embed("Water the tomatoes evenly", 384);
  Assert.Equal(384, a.Count);
  Assert.Equal(a, b);
  var length = 0.0;
  foreach (var v in a) { length = length + v * v; }
  Assert.True(Math.Abs(length - 1.0) < 0.000001);
}

[Test]
void the_commonest_words_count_for_nothing() {
  var e = new WordsEmbedder();
  Assert.Equal(new List<string> { "water", "tomatoes", "evenly" }, e.WordsOf("Water the tomatoes, and evenly!"));
}
